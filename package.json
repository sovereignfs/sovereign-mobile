{
  "name": "sovereign-mobile",
  "version": "0.2.0",
  "private": true,
  "description": "Sovereign mobile shell — a minimal Capacitor app that loads your self-hosted Sovereign instance",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "build:web": "tsc && vite build",
    "build": "pnpm build:web && cap sync",
    "sync": "cap sync",
    "dev:ios": "pnpm build:web && cap sync ios && cap open ios",
    "dev:android": "pnpm build:web && cap sync android && cap open android",
    "cap": "cap",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.4.2",
    "@capacitor/preferences": "^8.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^15.14.0",
    "prettier": "^3.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@11.5.2"
}
